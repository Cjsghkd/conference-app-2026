# --- macOS ---
.DS_Store

# --- Gradle / JVM ---
.gradle/
build/
**/build/
local.properties
*.log

# --- Kotlin ---
.kotlin/

# --- IDE ---
**/.idea/*
!**/.idea/dictionaries
**/.idea/dictionaries/*
!**/.idea/dictionaries/dictionary.xml
*.iml
.vscode/

# --- Xcode ---
**/xcuserdata/
*.xcuserstate

# --- SwiftPM import ---
# The Kotlin Gradle plugin regenerates .swiftpm-locks/<id>/.gitignore with the directory form only,
# which does not match the symbolic link scripts/link-swiftpm-cache.sh puts in its place.
.swiftpm-locks/*/swiftPMCheckout

# --- Screenshot outputs (Roborazzi goldens; a CI golden store is a separate decision) ---
screenshots/

# --- VitePress docs site ---
docs-site/node_modules/
docs-site/.vitepress/cache/
docs-site/.vitepress/dist/
docs/node_modules
